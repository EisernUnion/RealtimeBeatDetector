<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>RealtimeBeatDetector</RootNamespace>
    <AssemblyName>RealtimeBeatDetector</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    
    <!-- NuGet Package Metadata -->
    <PackageId>RealtimeBeatDetector</PackageId>
    <Version>1.0.0</Version>
    <Authors>EisernUnion</Authors>
    <Company>EisernUnion</Company>
    <Product>RealtimeBeatDetector</Product>
    <Description>A .NET library for real-time beat detection and BPM calculation from system audio output. Uses energy-based detection with adaptive thresholds to identify beats in music and audio streams.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EisernUnion/RealtimeBeatDetector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EisernUnion/RealtimeBeatDetector</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>audio;beat-detection;bpm;music;realtime;cscore;sound-analysis</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CSCore" Version="1.2.1.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>